# Porta HTTP/WebSocket do servidor Express (padrão: 3000)
PORT=3000

# Endereço de bind (padrão: 127.0.0.1 em desenvolvimento, 0.0.0.0 em produção)
HOST=127.0.0.1

# Ambiente de execução: development ou production
NODE_ENV=development

# Lista separada por vírgulas de origens adicionais permitidas no CORS e WebSocket
# ALLOWED_ORIGINS=https://occ.seudominio.pt

# Defina como true apenas em demonstrações para preencher chegadas fictícias caso haja menos de 6 voos
ENABLE_DEMO_FALLBACK=false
